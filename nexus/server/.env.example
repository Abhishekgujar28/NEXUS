# App Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/nexus

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Auth Configuration
JWT_SECRET=change-this-to-a-secure-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-secure-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Configuration
DEFAULT_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
TOGETHER_API_KEY=your-together-api-key

# Research APIs
SERPER_API_KEY=your-serper-api-key
GITHUB_TOKEN=your-github-personal-access-token
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key

# Vector DB
CHROMA_URL=http://localhost:8000

# Worker Settings (Optional)
RESEARCH_WORKER_CONCURRENCY=2
RESEARCH_JOB_ATTEMPTS=2
PROVIDER_TIMEOUT_MS=15000
MAX_SOURCES_PER_PROVIDER=10

# Optional: Telegram bot
TELEGRAM_BOT_TOKEN=
