# =========================================================
# NEXUS Enterprise Backend Environment Specification (.env.example)
# =========================================================

# 1. Server Configuration
# Deployment environment: 'development' | 'staging' | 'production'
NODE_ENV=development
# HTTP port server listens on
PORT=5000
# Allowed frontend URL origin for CORS headers
FRONTEND_URL=http://localhost:5173

# 2. Database Configuration
# MongoDB connection URI (Mongoose pool)
MONGODB_URI=mongodb://localhost:27017/nexus

# 3. Redis Configuration
# Redis server host for queues, locks, and caching
REDIS_HOST=localhost
# Redis server port
REDIS_PORT=6379
# Redis authentication password (leave blank if unauthenticated)
REDIS_PASSWORD=
# Redis database index number
REDIS_DB=0
# Connection URL for IORedis client
REDIS_URL=redis://localhost:6379

# 4. Authentication & Security
# HMAC-SHA256 secret key for signing short-lived JWT access tokens (min 32 chars)
JWT_SECRET=change-this-to-a-secure-secret-min-32-chars
# HMAC-SHA256 secret key for signing long-lived refresh tokens (min 32 chars)
JWT_REFRESH_SECRET=change-this-to-a-different-secure-secret-min-32-chars
# Access token expiration interval (e.g. 15m)
JWT_EXPIRES_IN=15m
# Refresh token expiration interval (e.g. 7d)
JWT_REFRESH_EXPIRES_IN=7d

# 5. AI Providers Configuration
# Default LLM provider for unassigned pipeline tasks
DEFAULT_AI_PROVIDER=openrouter
# API key for OpenRouter aggregator provider
OPENROUTER_API_KEY=your-openrouter-api-key
# Base URL for OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# API key for Google Gemini 1.5 Pro provider
GEMINI_API_KEY=your-gemini-api-key
# API key for OpenAI GPT-4o provider (Optional)
OPENAI_API_KEY=your-openai-api-key
# API key for Anthropic Claude 3.5 Sonnet provider (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key
# API key for Groq Llama3 provider (Optional)
GROQ_API_KEY=your-groq-api-key
# API key for DeepSeek R1 provider (Optional)
DEEPSEEK_API_KEY=your-deepseek-api-key
# API key for Together AI provider (Optional)
TOGETHER_API_KEY=your-together-api-key

# 6. Search Providers Configuration
# API key for Serper Google Web search provider
SERPER_API_KEY=your-serper-api-key
# GitHub personal access token for repository and code searches
GITHUB_TOKEN=your-github-personal-access-token
# API key for Semantic Scholar academic research provider
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
# API key for OpenAlex academic citations provider (Optional)
OPENALEX_API_KEY=
# API key for IEEE Xplore paper repository provider (Optional)
IEEE_XPLORE_API_KEY=
# API key for Stack Overflow API provider (Optional)
STACKOVERFLOW_API_KEY=
# Client ID for Reddit engineering subreddits provider (Optional)
REDDIT_CLIENT_ID=
# Client Secret for Reddit engineering subreddits provider (Optional)
REDDIT_CLIENT_SECRET=
# API key for Dev.to technical articles provider (Optional)
DEVTO_API_KEY=
# API key for Google Patents search provider (Optional)
GOOGLE_PATENTS_API_KEY=
# API key for YouTube technical talk transcript provider (Optional)
YOUTUBE_API_KEY=
# Custom URL for NPM package registry provider (Optional)
NPM_REGISTRY_URL=https://registry.npmjs.org
# Custom URL for PyPI Python package registry provider (Optional)
PYPI_REGISTRY_URL=https://pypi.org/pypi

# 7. Render & Export Services Configuration
# Base URL for Kroki Mermaid diagram rendering microservice fallback (Optional)
KROKI_URL=https://kroki.io

# 8. Storage & AWS S3 Configuration (Optional)
# S3 bucket name for exporting report artifacts and diagram files
S3_BUCKET_NAME=
# AWS region for S3 artifact storage bucket
S3_REGION=us-east-1
# AWS access key ID for S3 storage
S3_ACCESS_KEY_ID=
# AWS secret access key for S3 storage
S3_SECRET_ACCESS_KEY=

# 9. Email Services Configuration (Optional)
# SMTP host for system notifications and user verification emails
SMTP_HOST=
# SMTP port for system email dispatch
SMTP_PORT=587
# SMTP username for authentication
SMTP_USER=
# SMTP password for authentication
SMTP_PASSWORD=

# 10. Vector Database & RAG Configuration
# ChromaDB service endpoint URL
CHROMA_URL=http://localhost:8000
# Vector store selection: 'memory' or 'chroma' (Optional)
VECTOR_STORE=memory
# RAG chunk size in characters for source indexing (Optional)
RAG_CHUNK_SIZE=1200
# RAG chunk overlap in characters (Optional)
RAG_CHUNK_OVERLAP=150
# Number of top vector matches to retrieve per query (Optional)
RAG_TOP_K=8
# Maximum total character length of assembled RAG context (Optional)
RAG_MAX_CONTEXT_CHARS=12000
# Number of prior chat messages retained in Copilot conversation window (Optional)
COPILOT_HISTORY_WINDOW=10

# 11. Monitoring, Worker & Telemetry Configuration (Optional)
# Maximum worker concurrency for processing BullMQ research jobs
WORKER_CONCURRENCY=5
# Maximum worker concurrency configured in core config
RESEARCH_WORKER_CONCURRENCY=2
# Number of retry attempts for failed BullMQ research jobs
RESEARCH_JOB_ATTEMPTS=2
# Timeout in milliseconds per research provider API call
PROVIDER_TIMEOUT_MS=15000
# Maximum sources retrieved per search provider run
MAX_SOURCES_PER_PROVIDER=10
# Optional Telegram bot notification token
TELEGRAM_BOT_TOKEN=
