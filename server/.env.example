# =========================================================
# NEXUS Environment Specification (.env.example)
# =========================================================

# 1. Application & Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# 2. Database (MongoDB Atlas / Managed Mongoose Pool)
MONGODB_URI=mongodb://localhost:27017/nexus

# 3. Redis (BullMQ Queues & Socket.IO Redis Pub/Sub)
REDIS_URL=redis://localhost:6379

# 4. Authentication & Security
# HMAC-SHA256 secret keys (Must be at least 32 characters long in production)
JWT_SECRET=your-secure-jwt-secret-min-32-characters
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-min-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 5. AI LLM Providers
DEFAULT_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
TOGETHER_API_KEY=your-together-api-key

# 6. Research & Search Providers
SERPER_API_KEY=your-serper-api-key
GITHUB_TOKEN=your-github-personal-access-token
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
IEEE_XPLORE_API_KEY=your-ieee-api-key

# 7. Diagram Rendering & Export
KROKI_URL=https://kroki.io

# 8. Vector Store & RAG
VECTOR_STORE=memory
CHROMA_URL=http://localhost:8000
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=12000

# 9. Research Worker Configuration
RESEARCH_WORKER_CONCURRENCY=2
RESEARCH_JOB_ATTEMPTS=2
PROVIDER_TIMEOUT_MS=15000
MAX_SOURCES_PER_PROVIDER=10
